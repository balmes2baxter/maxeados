# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Login de desarrollo con correo (solo con Supabase local: `npx supabase start`).
# Muestra "Modo desarrollo" en /login. Déjalo vacío o en false en producción.
NEXT_PUBLIC_DEV_LOGIN=
