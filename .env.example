# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Login sin Google: se activa solo si NEXT_PUBLIC_SUPABASE_URL es local (127.0.0.1/localhost).
# Para local no hace falta copiar este archivo: usa `npm run setup:local`.
# Opcional: true|false para forzarlo. Nunca "true" en producción.
NEXT_PUBLIC_DEV_LOGIN=
